---
import { Image } from "astro:assets";
import { ArrowUpRight, ArrowRight, Clock } from "lucide-astro";
import type { CollectionEntry } from "astro:content";
import { journalImages, formatPostDate } from "../../data/journal";
interface Props {
  post: CollectionEntry<"blog">;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const image = journalImages[post.id];
---

<article
  class:list={["studio-article-card", { "studio-article-featured": featured }]}
  data-filter-item
  data-category={post.data.category}
>
  <a
    class="studio-article-image"
    href={`/blog/${post.id}`}
    aria-label={`Read ${post.data.title}`}
  >
    {
      image ? (
        <Image
          src={image}
          alt=""
          width={1200}
          widths={[500, 800, 1200]}
          sizes={
            featured
              ? "(max-width: 700px) 90vw, 60vw"
              : "(max-width: 700px) 90vw, 45vw"
          }
          loading={featured ? "eager" : "lazy"}
        />
      ) : (
        <img
          src={post.data.imageUrl}
          alt=""
          width="800"
          height="500"
          loading="lazy"
        />
      )
    }
    {
      !featured && (
        <span class="home-journal-arrow">
          <ArrowUpRight size={26} aria-hidden="true" />
        </span>
      )
    }
  </a>
  <div class="studio-article-copy">
    <div class="studio-article-topline">
      <span class="studio-article-category">{post.data.category}</span>{
        featured && <span class="studio-featured-label">Latest article</span>
      }
    </div><h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2><p>
      {post.data.excerpt}
    </p><div class="studio-article-bottom">
      <time datetime={post.data.date.toISOString()}
        >{formatPostDate(post.data.date)}</time
      ><span><Clock size={15} aria-hidden="true" />{post.data.readTime}</span>
    </div>{
      featured && (
        <a class="home-button" href={`/blog/${post.id}`}>
          Read the article <ArrowRight size={18} aria-hidden="true" />
        </a>
      )
    }
  </div>
</article>
