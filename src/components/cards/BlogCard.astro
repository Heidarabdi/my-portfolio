---
import { Clock, ArrowRight, Newspaper } from "lucide-astro";
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
---

<a href={`/blog/${post.id}`} class="group block h-full focus:outline-none">
  <div
    class="bg-paper-light border-ink hard-shadow-sm flex h-full flex-col border-2 transition-all duration-300 group-hover:-translate-y-1 group-hover:shadow-[6px_6px_0px_0px_var(--ink)]"
  >
    <div class="border-ink relative aspect-video overflow-hidden border-b-2">
      <Image
        src={post.data.imageUrl}
        alt={post.data.title}
        width={600}
        height={400}
        class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0"
      />
      <div
        class="bg-ink text-paper absolute top-0 left-0 px-2 py-1 text-[10px] font-bold tracking-widest uppercase"
      >
        {post.data.category}
      </div>
    </div>
    <div class="flex flex-1 flex-col p-6">
      <header
        class="border-line-medium mb-4 flex items-center justify-between border-b pb-2"
      >
        <time class="font-mono text-xs font-bold text-stone-400"
          >{post.data.date}</time
        >
        <div class="text-stone-400">
          <Newspaper class="h-4 w-4" />
        </div>
      </header>
      <h3
        class="text-ink group-hover:text-accent mb-3 font-serif text-2xl leading-tight font-bold transition-colors"
      >
        {post.data.title}
      </h3>
      <p
        class="mb-6 line-clamp-3 flex-1 font-serif text-sm leading-relaxed text-stone-600"
      >
        {post.data.excerpt}
      </p>
      <footer
        class="border-paper-dim mt-auto flex items-center justify-between border-t-2 pt-4 text-sm"
      >
        <span class="flex items-center gap-1 font-mono text-xs text-stone-500"
          ><Clock class="h-3 w-3" />
          {post.data.readTime}</span
        >
        <span
          class="text-ink flex items-center gap-1 text-xs font-bold uppercase transition-all group-hover:gap-2"
          >Read Issue
          <ArrowRight class="h-3 w-3" /></span
        >
      </footer>
    </div>
  </div>
</a>
