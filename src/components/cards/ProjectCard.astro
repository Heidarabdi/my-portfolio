---
import { Image } from "astro:assets";
import type { Project } from "../../data/siteData";

interface Props {
    project: Project;
}

const { project } = Astro.props;
---

<div
    class="project-card hard-shadow-sm group border-ink bg-paper-light flex h-full cursor-pointer flex-col border-2 transition-all duration-300 hover:-translate-y-1 hover:shadow-[6px_6px_0px_0px_var(--color-ink)]"
    data-category={project.category}
    data-id={project.id}
>
    <div class="p-3 pb-0">
        <div
            class="border-line-faint relative aspect-video overflow-hidden border"
        >
            <Image
                src={project.imageUrl}
                alt={project.title}
                width={600}
                height={400}
                class="h-full w-full object-cover grayscale filter transition-all duration-700 group-hover:scale-105 group-hover:grayscale-0"
            />
            <div
                class="bg-ink text-paper absolute top-2 right-2 px-2 py-1 text-xs font-bold opacity-0 transition-opacity group-hover:opacity-100"
            >
                REF.0{project.id}
            </div>
            <div
                class="bg-paper-light/90 text-ink absolute bottom-2 left-2 inline-flex items-center gap-1 px-1.5 py-0.5 text-[10px] font-bold tracking-widest uppercase"
            >
                {project.category}
            </div>
        </div>
    </div>
    <div class="flex flex-1 flex-col p-6">
        <h3
            class="text-ink group-hover:text-accent mb-2 font-serif text-2xl font-bold transition-colors"
        >
            {project.title}
        </h3>
        <p
            class="border-line-medium mb-4 line-clamp-2 border-l-2 pl-3 font-serif text-sm leading-relaxed text-stone-600"
        >
            {project.description}
        </p>
        <div class="mt-auto flex flex-wrap items-center gap-2">
            {
                project.technologies
                    .slice(0, 2)
                    .map((tech) => (
                        <span class="border-ink text-ink inline-flex items-center gap-1 border bg-transparent px-1.5 py-0.5 text-[10px] font-bold tracking-widest uppercase">
                            {tech}
                        </span>
                    ))
            }
        </div>
    </div>
</div>
