---
import type { ProjectData } from "../../types/project";
import { ArrowUpRight } from "lucide-astro";
interface Props {
  project: ProjectData;
  featured?: boolean;
  wide?: boolean;
}
const { project, featured = false, wide = false } = Astro.props;
---

<article
  class:list={[
    "project-card studio-project-card",
    { "studio-project-featured": featured },
    { "studio-project-wide": wide },
  ]}
  data-category={project.category}
  data-id={project.id}
>
  <div class="studio-project-image">
    <img
      src={project.imageUrl || "/images/portfolio/project-placeholder.svg"}
      alt={`${project.title} — ${project.imageNote?.toLowerCase() || "project preview"}`}
      width="1200"
      height="800"
      loading={featured ? "eager" : "lazy"}
    /><span class="studio-visual-label">{project.imageNote}</span><span
      class="studio-project-arrow"
      ><ArrowUpRight size={27} aria-hidden="true" /></span
    >
  </div>
  <div class="studio-project-copy">
    <div class="studio-project-meta">
      <span
        >{
          project.category === "IT Support" ? "IT & systems" : project.category
        }</span
      ><span>{project.year}</span>
    </div><h3>{project.title}</h3>{
      project.client && <p class="studio-project-client">{project.client}</p>
    }<p class="studio-project-description">{project.description}</p><ul
      class="studio-tech-tags"
      aria-label="Technologies"
    >
      {project.technologies.slice(0, 3).map((tech) => <li>{tech}</li>)}
    </ul><span class="studio-project-open"
      >View project <ArrowUpRight size={17} aria-hidden="true" /></span
    >
  </div>
  <button
    type="button"
    class="studio-card-hitarea"
    data-project-id={project.id}
    aria-label={`View details for ${project.title}`}
    aria-haspopup="dialog"
    aria-controls="project-modal"></button>
</article>
