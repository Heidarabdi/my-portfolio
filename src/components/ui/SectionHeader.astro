---
interface Props {
    title: string;
    subtitle: string;
    badge: string;
}

const { title, subtitle, badge } = Astro.props;
---

<div
    class="border-ink reveal mb-16 flex flex-col items-end justify-between border-b-4 pb-6 md:flex-row"
>
    <div class="max-w-2xl">
        <h2 class="text-ink mb-4 font-serif text-4xl font-bold md:text-5xl">
            {title}
        </h2>
        <p class="font-serif text-lg text-stone-600 italic">
            {subtitle}
        </p>
    </div>
    <div
        class="bg-accent mt-4 px-3 py-1 text-sm font-bold tracking-widest text-white uppercase md:mt-0"
    >
        {badge}
    </div>
</div>
