---
interface Props {
    class?: string;
    variant?: "outline" | "filled" | "neutral";
}

const { class: className, variant = "outline" } = Astro.props;
---

<span
    class:list={[
        "inline-flex items-center gap-1 text-[10px] font-bold tracking-widest uppercase",
        variant === "outline" &&
            "border-ink text-ink border bg-transparent px-1.5 py-0.5",
        variant === "filled" && "bg-accent px-3 py-1 text-white",
        variant === "neutral" &&
            "bg-paper-light border-ink text-ink hard-shadow-sm border px-4 py-2 text-xs" /* For 'Available for Hire' badge */,
        className,
    ]}
>
    <slot />
</span>
