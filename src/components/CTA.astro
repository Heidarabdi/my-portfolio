---
import { Send } from "lucide-astro";
---

<section
    class="bg-ink border-ink hard-shadow relative mx-auto mb-12 overflow-hidden border-2 py-24 text-center md:max-w-7xl"
>
    <div
        class="pointer-events-none absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,rgba(255,255,255,0.05)_50%,transparent_75%,transparent_100%)] bg-size-[20px_20px] opacity-20"
    >
    </div>
    <div class="relative z-10 px-6">
        <h2 class="text-paper font-display mb-8 text-4xl font-bold md:text-5xl">
            Let's Work Together
        </h2>
        <p
            class="font-display mx-auto mb-12 max-w-xl text-lg leading-relaxed text-stone-400 italic"
        >
            I'm currently available for freelance projects and open to full-time
            opportunities. Ready to engineer something exceptional?
        </p>
        <a
            href="/contact"
            class="bg-paper-light text-ink hover:bg-accent hover:border-accent transition-vintage hard-shadow-sm group inline-flex items-center gap-3 border-2 border-transparent px-10 py-5 text-sm font-bold tracking-widest uppercase hover:text-white md:text-base"
        >
            <Send
                class="h-5 w-5 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1"
            />
            Get in Touch
        </a>
    </div>
</section>
