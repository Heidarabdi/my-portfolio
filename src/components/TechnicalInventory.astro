---
import {
    Layout,
    Terminal,
    Globe,
    Code2,
    Sparkles,
    Smartphone,
    Monitor,
    Code,
    Server,
    BarChart2,
    Database,
    Settings,
    HardDrive,
    Download,
    Wifi,
    Briefcase,
    Search,
    MessageSquare,
    Cpu,
} from "lucide-astro";
import Section from "./Section.astro";
import Card from "./ui/Card.astro";
import Badge from "./ui/Badge.astro";

// We ignore props for now to ensure 1:1 match with export HTML content
// The export has 4 specific columns with specific items.
---

<Section>
    <div
        class="border-ink mb-16 items-end justify-between border-b-4 pb-6 md:flex"
    >
        <div class="max-w-2xl">
            <h2
                class="text-ink font-display mb-4 text-4xl font-bold md:text-5xl"
            >
                Technical Inventory
            </h2>
            <p class="font-display text-lg text-stone-600 italic">
                Tools and methodologies currently utilized in production.
            </p>
        </div>
        <div class="mt-4 md:mt-0">
            <Badge variant="filled">Section 02</Badge>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4">
        <!-- Full Stack -->
        <Card class="h-full p-6">
            <div class="mb-6 flex items-start justify-between">
                <div
                    class="border-ink text-ink transition-vintage flex h-12 w-12 items-center justify-center border-2 bg-stone-100"
                >
                    <Layout class="h-6 w-6" />
                </div>
                <span class="font-mono text-xs font-bold text-stone-400"
                    >01</span
                >
            </div>
            <h3
                class="text-ink mb-6 border-b-2 border-stone-200 pb-2 text-lg font-bold tracking-wider uppercase"
            >
                Full Stack Development
            </h3>
            <div class="space-y-3">
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Code2
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Web Development</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Smartphone
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Mobile App Dev</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Monitor
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Responsive Design</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Code
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold">React</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Server
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold">Node.js</span>
                </div>
            </div>
        </Card>

        <!-- Machine Learning -->
        <Card class="h-full p-6">
            <div class="mb-6 flex items-start justify-between">
                <div
                    class="border-ink text-ink transition-vintage flex h-12 w-12 items-center justify-center border-2 bg-stone-100"
                >
                    <Sparkles class="h-6 w-6" />
                </div>
                <span class="font-mono text-xs font-bold text-stone-400"
                    >02</span
                >
            </div>
            <h3
                class="text-ink mb-6 border-b-2 border-stone-200 pb-2 text-lg font-bold tracking-wider uppercase"
            >
                Machine Learning
            </h3>
            <div class="space-y-3">
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Cpu
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Model Development</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><BarChart2
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Optimization</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Terminal
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold">Python</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Database
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Data Integration</span>
                </div>
            </div>
        </Card>

        <!-- IT Operations -->
        <Card class="h-full p-6">
            <div class="mb-6 flex items-start justify-between">
                <div
                    class="border-ink text-ink transition-vintage flex h-12 w-12 items-center justify-center border-2 bg-stone-100"
                >
                    <Terminal class="h-6 w-6" />
                </div>
                <span class="font-mono text-xs font-bold text-stone-400"
                    >03</span
                >
            </div>
            <h3
                class="text-ink mb-6 border-b-2 border-stone-200 pb-2 text-lg font-bold tracking-wider uppercase"
            >
                IT Operations
            </h3>
            <div class="space-y-3">
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Settings
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >System Maintenance</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><HardDrive
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold">Hardware</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Download
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Software Install</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Wifi
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Network Setup</span>
                </div>
            </div>
        </Card>

        <!-- Soft Skills -->
        <Card class="h-full p-6">
            <div class="mb-6 flex items-start justify-between">
                <div
                    class="border-ink text-ink transition-vintage flex h-12 w-12 items-center justify-center border-2 bg-stone-100"
                >
                    <Globe class="h-6 w-6" />
                </div>
                <span class="font-mono text-xs font-bold text-stone-400"
                    >04</span
                >
            </div>
            <h3
                class="text-ink mb-6 border-b-2 border-stone-200 pb-2 text-lg font-bold tracking-wider uppercase"
            >
                Soft Skills
            </h3>
            <div class="space-y-3">
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Briefcase
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Project Mgmt</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><Search
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Online Research</span>
                </div>
                <div class="flex items-center gap-3 text-stone-700">
                    <div class="bg-accent h-1.5 w-1.5"></div><MessageSquare
                        class="h-4 w-4"
                    /><span class="font-mono text-sm font-bold"
                        >Communication</span>
                </div>
            </div>
        </Card>
    </div>
</Section>
