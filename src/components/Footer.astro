---
const currentYear = new Date().getFullYear();
---

<footer class="border-ink mt-20 border-t-2 bg-stone-100 py-16">
  <div
    class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-8 px-6 md:flex-row"
  >
    <div class="text-ink-muted text-sm font-bold">
      © {currentYear} — HEIDAR DEV.
    </div>
    <div
      class="text-ink flex items-center gap-8 text-sm font-bold tracking-wider uppercase"
    >
      <a
        href="https://github.com/Heidarabdi/"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-accent focus:ring-accent rounded-sm px-1 transition-colors hover:underline focus:ring-2 focus:outline-none"
        >GitHub</a
      >
    </div>
  </div>
</footer>
