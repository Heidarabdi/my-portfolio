---
import { User, FileText, Layers, BookOpen, Moon } from "lucide-astro";

const pathname = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Home", icon: User },
  { href: "/about", label: "Profile", icon: FileText },
  { href: "/projects", label: "Works", icon: Layers },
  { href: "/blog", label: "Journal", icon: BookOpen },
];

const isActive = (href: string) => {
  if (href === "/" && pathname === "/") return true;
  if (href !== "/" && pathname.startsWith(href)) return true;
  return false;
};
---

<nav
  class="bg-paper/95 border-ink fixed top-0 right-0 left-0 z-40 border-b-2 backdrop-blur-sm transition-colors duration-300"
>
  <!-- Desktop/Main Bar -->
  <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-6">
    <a
      href="/"
      class="group flex items-center gap-3 rounded-sm focus:outline-none"
      data-astro-prefetch
    >
      <div
        class="bg-ink text-paper border-ink group-hover:bg-accent transition-vintage hard-shadow-sm relative flex h-10 w-10 items-center justify-center overflow-hidden border-2"
      >
        <div class="absolute inset-0 border border-white/20"></div>
        <span class="font-display text-xl italic">H</span>
      </div>
      <span
        class="font-display group-hover:text-accent text-lg font-bold tracking-tight transition-colors"
        >HeidarDev.</span
      >
    </a>

    <div class="flex items-center gap-6 md:gap-8">
      <!-- Clean Navigation -->
      <div class="hidden items-center gap-6 md:flex">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              data-astro-prefetch
              class:list={[
                "group flex items-center gap-2 text-sm font-medium transition-colors duration-200",
                isActive(item.href)
                  ? "text-ink"
                  : "hover:text-ink text-stone-500",
              ]}
            >
              <item.icon
                class:list={[
                  "h-4 w-4 transition-colors",
                  isActive(item.href)
                    ? "text-accent"
                    : "text-stone-400 group-hover:text-stone-600",
                ]}
              />
              <span>{item.label}</span>
              {isActive(item.href) && <span class="sr-only">(current)</span>}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-4">
        <button
          id="theme-toggle"
          class="hover:text-ink p-2 text-stone-500 transition-colors focus:outline-none"
          aria-label="Toggle theme"
        >
          <div id="theme-icon"><Moon class="h-5 w-5" /></div>
        </button>

        <a
          href="/contact"
          data-astro-prefetch
          class="bg-ink text-paper hover:bg-accent border-ink hard-shadow-sm hidden items-center justify-center border-2 px-4 py-2 text-sm font-medium transition-all hover:shadow-[4px_4px_0px_0px_var(--color-accent)] sm:inline-flex"
        >
          Contact
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile Sub-Bar -->
  <div
    class="border-ink/20 bg-paper flex justify-around border-t px-4 py-3 md:hidden"
  >
    {
      navItems.map((item) => (
        <a
          href={item.href}
          data-astro-prefetch
          class:list={[
            "flex flex-col items-center gap-1 px-3 py-1 text-xs font-medium transition-colors",
            isActive(item.href) ? "text-ink" : "text-stone-500",
          ]}
        >
          <item.icon
            class:list={[
              "h-4 w-4",
              isActive(item.href) ? "text-accent" : "text-stone-400",
            ]}
          />
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
</nav>
