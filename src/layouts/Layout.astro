---
import "../styles/global.css";
import "@fontsource/playfair-display/400-italic";
import "@fontsource/playfair-display/700";
import "@fontsource/space-mono/400";
import "@fontsource/space-mono/700";
import { ClientRouter } from "astro:transitions";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ArrowUp } from "lucide-astro";

interface Props {
  homepage?: boolean;
  title?: string;
  description?: string;
  ogUrl?: string;
  ogTitle?: string;
  ogDescription?: string;
  twitterCard?: string;
  twitterHandle?: string;
  twitterTitle?: string;
  twitterDescription?: string;
  twitterImage?: string;
}

const {
  homepage = false,
  title = "Heidar Dev Portfolio",
  description = "Engineering Intelligent Solutions",
  ogUrl,
  ogTitle,
  ogDescription,
  twitterCard = "summary_large_image",
  twitterHandle = "@heidarabdi",
  twitterTitle,
  twitterDescription,
  twitterImage,
} = Astro.props;

// Generate canonical URL
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Use provided OG values or fall back to defaults
const finalOgTitle = ogTitle || title;
const finalOgDescription = ogDescription || description;
const finalOgUrl = ogUrl || canonicalURL.toString();

const finalTwitterTitle = twitterTitle || title;
const finalTwitterDescription = twitterDescription || description;
---

<!doctype html>
<html lang="en" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/h.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Heidar Dev Blog"
      href="/rss.xml"
    />

    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={finalOgUrl} />
    <meta property="og:title" content={finalOgTitle} />
    <meta property="og:description" content={finalOgDescription} />

    <!-- Twitter -->
    <meta property="twitter:card" content={twitterCard} />
    <meta property="twitter:url" content={finalOgUrl} />
    <meta property="twitter:title" content={finalTwitterTitle} />
    <meta property="twitter:description" content={finalTwitterDescription} />
    {twitterHandle && <meta property="twitter:site" content={twitterHandle} />}
    {twitterImage && <meta property="twitter:image" content={twitterImage} />}

    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      try {
        const theme = localStorage.getItem("theme");
        document.documentElement.classList.toggle(
          "dark",
          theme
            ? theme === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches,
        );
      } catch {
        document.documentElement.classList.toggle(
          "dark",
          matchMedia("(prefers-color-scheme: dark)").matches,
        );
      }
    </script>
  </head>
  <body
    class:list={[
      "selection:bg-accent bg-paper text-ink transition-colors duration-300 selection:text-white",
      { "home-page": homepage },
    ]}
  >
    {!homepage && <div class="noise-overlay" />}

    {!homepage && <Navbar />}

    <slot />

    {!homepage && <Footer />}

    {
      !homepage && (
        <button
          id="back-to-top"
          class="bg-accent border-ink hard-shadow focus:ring-ink pointer-events-none fixed right-8 bottom-8 z-50 translate-y-4 border-2 p-3 text-white opacity-0 transition-all duration-300 hover:shadow-[6px_6px_0px_0px_var(--color-ink)] focus:ring-2 focus:ring-offset-2 focus:outline-none"
          aria-label="Back to top"
        >
          <ArrowUp class="h-6 w-6" />
        </button>
      )
    }

    <script>
      import "../scripts/layout";
    </script>

    <!-- Cloudflare Web Analytics -->
    {
      import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN && import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN}"}`}
        />
      )
    }
  </body>
</html>
