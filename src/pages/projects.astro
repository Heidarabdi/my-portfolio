---
import StudioLayout from "../layouts/StudioLayout.astro";
import StudioCTA from "../components/studio/StudioCTA.astro";
import ProjectCard from "../components/cards/ProjectCard.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import { toProjectData } from "../types/project";
import {
  X,
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  Github,
  Check,
} from "lucide-astro";
import research from "../assets/home/research.png";
import community from "../assets/home/community.png";
import workspace from "../assets/home/workspace.jpg";
const media = {
  "ml-integration-platform": { source: research, note: "Interface study" },
  "snwo-official-portal": { source: community, note: "Interface study" },
  "campus-it-infrastructure": { source: workspace, note: "Context photograph" },
};
const entries = (await getCollection("projects"))
  .map(toProjectData)
  .sort((a, b) => a.order - b.order);
const projects = await Promise.all(
  entries.map(async (project) => {
    const visual = media[project.id as keyof typeof media];
    if (!visual) return { ...project, imageNote: "Project illustration" };
    const image = await getImage({
      src: visual.source,
      width: 1200,
      format: "webp",
    });
    return {
      ...project,
      imageUrl: image.src,
      gallery: [image.src],
      imageNote: visual.note,
    };
  }),
);
const filters = [
  { key: "All", label: "All projects" },
  { key: "Web Development", label: "Web development" },
  { key: "Machine Learning", label: "Machine learning" },
  { key: "IT Support", label: "IT & systems" },
  { key: "Other", label: "Other" },
];
---

<StudioLayout
  current="projects"
  title="Projects — Heidar Abdi"
  description="Explore my work in web development, machine learning, and IT systems, from research platforms to community portals."
>
  <project-archive
    data-projects={JSON.stringify(projects)}
    class="studio-projects"
  >
    <main id="main-content">
      <header class="studio-page-heading home-inset">
        <a class="studio-back-link" href="/"
          ><ArrowLeft size={16} aria-hidden="true" /> Back to home</a
        >
        <div class="studio-heading-row">
          <h1>Thoughtful work.<br /><em>Practical impact.</em></h1><p>
            Web experiences, intelligent tools, and dependable systems. A closer
            look at what I build and how I approach it.
          </p>
        </div>
      </header>
      <section
        class="studio-work-section home-inset"
        aria-labelledby="project-list-title"
      >
        <div class="studio-collection-toolbar">
          <div>
            <h2 id="project-list-title">
              My projects<span class="studio-count">{projects.length}</span>
            </h2><p
              class="studio-result-count"
              data-result-count
              role="status"
              aria-live="polite"
            >
              Showing all {projects.length} projects
            </p>
          </div><a
            class="studio-text-link"
            href="https://github.com/Heidarabdi"
            target="_blank"
            rel="noopener noreferrer"
            >Explore GitHub <ArrowUpRight size={18} aria-hidden="true" /></a
          >
        </div>
        <div
          class="studio-filters"
          role="group"
          aria-label="Filter projects by category"
        >
          {
            filters.map((filter, index) => (
              <button
                type="button"
                class="filter-btn"
                data-filter={filter.key}
                aria-pressed={index === 0}
              >
                {filter.label}
                <span>
                  {
                    projects.filter(
                      (project) =>
                        filter.key === "All" || project.category === filter.key,
                    ).length
                  }
                </span>
              </button>
            ))
          }
        </div>
        <div class="studio-project-grid">
          {
            projects.map((project, index) => (
              <ProjectCard
                project={project}
                featured={index === 0}
                wide={
                  index === projects.length - 1 && projects.length % 2 === 0
                }
              />
            ))
          }
        </div>
        <p class="studio-image-note">
          Interface studies and illustrations show the direction of the work.
          They are labeled separately from project photography.
        </p>
      </section>
      <StudioCTA title="Let’s build your next project." />
    </main>
    <dialog
      id="project-modal"
      closedby="any"
      class="studio-project-dialog"
      aria-labelledby="modal-title"
      aria-describedby="modal-desc"
    >
      <button
        id="close-modal"
        type="button"
        class="studio-dialog-close"
        aria-label="Close project details"
        autofocus><X size={22} aria-hidden="true" /></button
      >
      <div class="studio-dialog-layout">
        <div class="studio-dialog-visual">
          <img
            id="modal-img"
            src={projects[0]?.imageUrl}
            alt=""
            width="1000"
            height="700"
          /><div class="studio-gallery-controls">
            <button
              id="prev-image"
              type="button"
              class="home-circle-control"
              aria-label="Previous project image"
              ><ArrowLeft size={20} aria-hidden="true" /></button
            ><span id="modal-img-counter"></span><button
              id="next-image"
              type="button"
              class="home-circle-control is-orange"
              aria-label="Next project image"
              ><ArrowRight size={20} aria-hidden="true" /></button
            >
          </div><p id="modal-image-note"></p>
        </div>
        <div class="studio-dialog-copy">
          <p id="modal-category" class="studio-dialog-category"></p><h2
            id="modal-title"
          >
          </h2><p id="modal-meta" class="studio-muted"></p><div
            id="modal-tech"
            class="studio-tech-tags"
          >
          </div><p id="modal-desc"></p><div class="studio-dialog-features">
            <h3><Check size={18} aria-hidden="true" /> What’s included</h3><ul
              id="modal-features-list"
            >
            </ul>
          </div><div id="modal-links" class="studio-dialog-links">
            <a
              id="modal-live-link"
              target="_blank"
              rel="noopener noreferrer"
              class="home-button"
              hidden
              >Visit project <ArrowUpRight size={18} aria-hidden="true" /></a
            ><a
              id="modal-github-link"
              target="_blank"
              rel="noopener noreferrer"
              class="home-button home-button-outline"
              hidden>Source code <Github size={18} aria-hidden="true" /></a
            >
          </div>
        </div>
      </div>
    </dialog>
  </project-archive>
  <script>
    import "../scripts/projects";
  </script>
</StudioLayout>
