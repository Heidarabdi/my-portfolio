---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { toProjectData } from "../types/project";
import ProjectCard from "../components/cards/ProjectCard.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import {
  X,
  ChevronLeft,
  ChevronRight,
  FolderOpen,
  ExternalLink,
  Github,
} from "lucide-astro";

// Fetch projects from content collection
const projectEntries = await getCollection("projects");

// Convert to ProjectData and sort by order
const projects = projectEntries
  .map(toProjectData)
  .sort((a, b) => a.order - b.order);

// Prepare JSON for client-side modal
const projectsJson = JSON.stringify(projects);

const title = "Works - Heidar Dev Portfolio";
---

<Layout title={title}>
  <main
    class="mx-auto min-h-screen max-w-7xl px-6 pt-24"
    transition:animate="fade"
  >
    <section class="relative min-h-screen py-20">
      <SectionHeader
        title="Project Archive"
        subtitle="The complete database of developed systems."
        badge="Section 03"
      />

      <!-- Filter Buttons -->
      <div class="reveal reveal-delay-100 mb-12 flex flex-wrap gap-4">
        <button
          class="filter-btn active hard-shadow-sm border-ink bg-ink text-paper rounded-sm border-2 px-4 py-2 text-xs font-bold tracking-widest uppercase transition-all focus:outline-none"
          data-filter="All"
        >
          All
        </button>
        <button
          class="filter-btn hover:border-ink hover:text-ink border-line-medium bg-paper-light rounded-sm border-2 px-4 py-2 text-xs font-bold tracking-widest text-stone-500 uppercase transition-all focus:outline-none"
          data-filter="Web Development"
        >
          Web Development
        </button>
        <button
          class="filter-btn hover:border-ink hover:text-ink border-line-medium bg-paper-light rounded-sm border-2 px-4 py-2 text-xs font-bold tracking-widest text-stone-500 uppercase transition-all focus:outline-none"
          data-filter="Machine Learning"
        >
          Machine Learning
        </button>
        <button
          class="filter-btn hover:border-ink hover:text-ink border-line-medium bg-paper-light rounded-sm border-2 px-4 py-2 text-xs font-bold tracking-widest text-stone-500 uppercase transition-all focus:outline-none"
          data-filter="IT Support"
        >
          IT Support
        </button>
        <button
          class="filter-btn hover:border-ink hover:text-ink border-line-medium bg-paper-light rounded-sm border-2 px-4 py-2 text-xs font-bold tracking-widest text-stone-500 uppercase transition-all focus:outline-none"
          data-filter="Other"
        >
          Other
        </button>
      </div>

      <div
        class="reveal reveal-delay-200 grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3"
      >
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </main>

  <!-- Dynamic Modal -->
  <div
    id="project-modal"
    class="fixed inset-0 flex hidden items-center justify-center p-4 outline-none sm:p-6"
    style="z-index: 10000;"
    role="dialog"
    aria-modal="true"
    tabindex="-1"
  >
    <div
      class="bg-paper/90 absolute inset-0 backdrop-blur-sm"
      id="modal-backdrop"
    >
    </div>
    <div
      class="bg-paper-light border-ink reveal relative flex max-h-[90vh] w-full max-w-5xl flex-col border-2 shadow-[10px_10px_0px_0px_var(--color-ink)] md:h-[650px] md:flex-row"
    >
      <button
        id="close-modal"
        class="bg-paper-light border-ink hover:bg-ink transition-vintage hard-shadow-sm absolute top-4 right-4 z-20 border-2 p-2 hover:text-white focus:outline-none"
      >
        <X class="h-5 w-5" />
      </button>

      <!-- Gallery Side -->
      <div
        class="bg-paper-dim border-ink flex w-full items-center justify-center border-b-2 p-8 md:w-3/5 md:border-r-2 md:border-b-0"
        style="background-image: radial-gradient(var(--color-ink-muted) 1px, transparent 1px); background-size: 16px 16px;"
      >
        <div
          class="border-paper-light relative w-full rotate-1 border-4 shadow-lg transition-transform duration-500 hover:rotate-0"
        >
          <div
            class="bg-paper-light flex aspect-video items-center justify-center overflow-hidden"
          >
            <img
              id="modal-img"
              src=""
              width={800}
              height={600}
              class="h-full w-full object-cover transition-opacity duration-300"
            />
          </div>

          <!-- Nav Buttons -->
          <button
            id="prev-image"
            class="bg-paper-light border-ink text-ink hard-shadow-sm transition-vintage absolute top-1/2 -left-3 z-10 -translate-y-1/2 border-2 p-3 hover:translate-y-[-2px] focus:outline-none md:-left-6"
          >
            <ChevronLeft class="h-5 w-5" />
          </button>
          <button
            id="next-image"
            class="bg-paper-light border-ink text-ink hard-shadow-sm transition-vintage absolute top-1/2 -right-3 z-10 -translate-y-1/2 border-2 p-3 hover:translate-y-[-2px] focus:outline-none md:-right-6"
          >
            <ChevronRight class="h-5 w-5" />
          </button>

          <!-- Counter -->
          <div
            id="modal-img-counter"
            class="bg-ink text-paper border-ink absolute -bottom-10 left-1/2 -translate-x-1/2 border-2 px-3 py-1 font-mono text-xs"
          >
            IMG_01 / 02
          </div>
        </div>
      </div>

      <!-- Content Side -->
      <div
        class="bg-paper-light flex h-full w-full flex-col overflow-y-auto p-8 md:w-2/5"
      >
        <div class="mb-6">
          <div class="mb-2 flex items-center gap-2">
            <span
              class="text-accent text-xs font-bold tracking-widest uppercase"
              >Project Dossier</span
            >
          </div>
          <h2
            id="modal-title"
            class="text-ink mb-4 font-serif text-4xl font-bold"
          >
          </h2>
          <div
            id="modal-tech"
            class="mb-8 flex flex-wrap gap-2 border-b-2 border-dashed border-stone-200 pb-6"
          >
          </div>
          <p
            id="modal-desc"
            class="mb-6 font-serif text-sm leading-relaxed text-stone-600 md:text-base"
          >
          </p>
        </div>

        <div class="bg-paper-dim border-line-medium mb-8 border p-4">
          <h4
            class="text-ink mb-4 flex items-center gap-2 text-xs font-bold tracking-widest uppercase"
          >
            <FolderOpen class="h-4 w-4" />
            Specifications
          </h4>
          <ul id="modal-features-list" class="space-y-3"></ul>
        </div>

        <div id="modal-links" class="mt-auto flex flex-col gap-3 pt-6">
          <a
            id="modal-live-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-ink text-paper border-ink hover:bg-accent hover:border-accent hidden w-full items-center justify-center gap-2 border-2 py-3 font-bold tracking-widest uppercase transition-colors"
          >
            Launch Project
            <ExternalLink class="h-4 w-4" />
          </a>
          <a
            id="modal-github-link"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-paper-light text-ink border-ink hidden w-full items-center justify-center gap-2 border-2 py-3 font-bold tracking-widest uppercase transition-shadow hover:shadow-[4px_4px_0px_0px_var(--color-accent)]"
          >
            Source Code
            <Github class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ projectsJson }}>
    // Parse projects data
    const PROJECTS = JSON.parse(projectsJson);

    // ---------------------------------------------------------
    // 1. FILTER LOGIC
    // ---------------------------------------------------------
    function initFilter() {
      const filterBtns = document.querySelectorAll(".filter-btn");
      const projectCards = document.querySelectorAll(".project-card");

      if (filterBtns.length > 0) {
        // Initialize first button as active
        const firstBtn = filterBtns[0];
        if (!firstBtn.classList.contains("active")) {
          firstBtn.classList.remove(
            "bg-paper-light",
            "text-stone-500",
            "border-line-medium",
          );
          firstBtn.classList.add(
            "active",
            "bg-ink",
            "text-paper",
            "border-ink",
            "hard-shadow-sm",
          );
        }

        filterBtns.forEach((btn) => {
          btn.addEventListener("click", () => {
            // Batch DOM updates in single frame to prevent flash
            requestAnimationFrame(() => {
              // Reset ALL buttons to inactive style
              filterBtns.forEach((b) => {
                b.classList.remove(
                  "active",
                  "bg-ink",
                  "text-paper",
                  "border-ink",
                  "hard-shadow-sm",
                );
                b.classList.add(
                  "bg-paper-light",
                  "text-stone-500",
                  "border-line-medium",
                );
              });

              // Set clicked button to active style
              btn.classList.remove(
                "bg-paper-light",
                "text-stone-500",
                "border-line-medium",
              );
              btn.classList.add(
                "active",
                "bg-ink",
                "text-paper",
                "border-ink",
                "hard-shadow-sm",
              );

              // Filter Logic
              const filter = btn.getAttribute("data-filter");
              projectCards.forEach((card) => {
                const category = card.getAttribute("data-category");
                if (filter === "All" || category === filter) {
                  card.classList.remove("hidden");
                  // Reset animation
                  card.animate(
                    [
                      {
                        opacity: 0,
                        transform: "scale(0.95)",
                      },
                      {
                        opacity: 1,
                        transform: "scale(1)",
                      },
                    ],
                    {
                      duration: 300,
                      easing: "cubic-bezier(0.4, 0, 0.2, 1)",
                    },
                  );
                } else {
                  card.classList.add("hidden");
                }
              });
            });
          });
        });
      }
    }

    // ---------------------------------------------------------
    // 2. MODAL LOGIC
    // ---------------------------------------------------------
    let currentProject = null;
    let currentGalleryIndex = 0;

    function openModal(projectId) {
      currentProject = PROJECTS.find((p) => p.id === projectId);
      if (!currentProject) return;

      currentGalleryIndex = 0;

      // Populate Title & Desc
      document.getElementById("modal-title").innerText = currentProject.title;
      document.getElementById("modal-desc").innerText =
        currentProject.longDescription || currentProject.description;

      // Populate Technologies
      const techContainer = document.getElementById("modal-tech");
      techContainer.innerHTML = "";
      currentProject.technologies.forEach((tech) => {
        const badge = document.createElement("span");
        badge.className =
          "inline-flex items-center font-bold uppercase tracking-widest border border-stone-300 bg-stone-100 text-stone-600 px-2 py-1 text-xs gap-1.5";
        badge.innerText = tech;
        techContainer.appendChild(badge);
      });

      // Populate Features
      const featureList = document.getElementById("modal-features-list");
      if (featureList && currentProject.features) {
        featureList.innerHTML = "";
        currentProject.features.forEach((feat) => {
          const li = document.createElement("li");
          li.className = "flex items-start gap-3 text-sm text-stone-700";
          // We use simple SVG string for dynamic content to avoid complex hydration
          li.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check-square w-4 h-4 text-accent mt-0.5 shrink-0"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m9 12 2 2 4-4"/></svg> ${feat}`;
          featureList.appendChild(li);
        });
      }

      // Handle links
      const liveLink = document.getElementById("modal-live-link");
      const githubLink = document.getElementById("modal-github-link");

      if (currentProject.liveUrl) {
        liveLink.href = currentProject.liveUrl;
        liveLink.classList.remove("hidden");
        liveLink.classList.add("flex");
      } else {
        liveLink.classList.add("hidden");
        liveLink.classList.remove("flex");
      }

      if (currentProject.githubUrl) {
        githubLink.href = currentProject.githubUrl;
        githubLink.classList.remove("hidden");
        githubLink.classList.add("flex");
      } else {
        githubLink.classList.add("hidden");
        githubLink.classList.remove("flex");
      }

      const modal = document.getElementById("project-modal");
      modal.classList.remove("hidden");
      document.body.classList.add("modal-open");
      modal.focus();

      updateGalleryImage();
    }

    function closeModal() {
      const modal = document.getElementById("project-modal");
      modal.classList.add("hidden");
      document.body.classList.remove("modal-open");
      currentProject = null;
    }

    function updateGalleryImage() {
      if (!currentProject) return;
      const imgEl = document.getElementById("modal-img");
      const gallery =
        currentProject.gallery.length > 0
          ? currentProject.gallery
          : [currentProject.imageUrl];

      // Fade out
      imgEl.style.opacity = "0";
      setTimeout(() => {
        imgEl.src = gallery[currentGalleryIndex];
        imgEl.style.opacity = "1";
      }, 200);

      const counterEl = document.getElementById("modal-img-counter");
      if (counterEl) {
        counterEl.innerText = `IMG_0${currentGalleryIndex + 1} / 0${gallery.length}`;
      }
    }

    // Event Bindings
    function initModal() {
      // Card Clicks
      document.querySelectorAll(".project-card").forEach((card) => {
        card.addEventListener("click", () => {
          const projectId = card.getAttribute("data-id");
          openModal(projectId);
        });
      });

      // Modal Controls
      document
        .getElementById("close-modal")
        ?.addEventListener("click", closeModal);
      document
        .getElementById("modal-backdrop")
        ?.addEventListener("click", closeModal);

      document.getElementById("prev-image")?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!currentProject) return;
        const gallery =
          currentProject.gallery.length > 0
            ? currentProject.gallery
            : [currentProject.imageUrl];
        currentGalleryIndex =
          (currentGalleryIndex - 1 + gallery.length) % gallery.length;
        updateGalleryImage();
      });

      document.getElementById("next-image")?.addEventListener("click", (e) => {
        e.stopPropagation();
        if (!currentProject) return;
        const gallery =
          currentProject.gallery.length > 0
            ? currentProject.gallery
            : [currentProject.imageUrl];
        currentGalleryIndex = (currentGalleryIndex + 1) % gallery.length;
        updateGalleryImage();
      });

      // Keyboard
      document.addEventListener("keydown", (e) => {
        const modal = document.getElementById("project-modal");
        if (modal.classList.contains("hidden")) return;

        if (e.key === "Escape") closeModal();
        if (e.key === "ArrowRight") {
          if (!currentProject) return;
          const gallery =
            currentProject.gallery.length > 0
              ? currentProject.gallery
              : [currentProject.imageUrl];
          currentGalleryIndex = (currentGalleryIndex + 1) % gallery.length;
          updateGalleryImage();
        }
        if (e.key === "ArrowLeft") {
          if (!currentProject) return;
          const gallery =
            currentProject.gallery.length > 0
              ? currentProject.gallery
              : [currentProject.imageUrl];
          currentGalleryIndex =
            (currentGalleryIndex - 1 + gallery.length) % gallery.length;
          updateGalleryImage();
        }
      });
    }

    // Check for hash in URL and open modal
    function checkHashAndOpenModal() {
      const hash = window.location.hash;
      if (hash && hash.length > 1) {
        const projectId = hash.substring(1); // Remove the #
        const project = PROJECTS.find((p) => p.id === projectId);
        if (project) {
          // Small delay to ensure DOM is ready
          setTimeout(() => {
            openModal(projectId);
          }, 100);
        }
      }
    }

    // Run Logic (Handle View Transitions)
    function run() {
      initFilter();
      initModal();
      checkHashAndOpenModal();
    }

    // Astro events
    document.addEventListener("astro:page-load", run);
    if (document.readyState !== "loading") run();
    else document.addEventListener("DOMContentLoaded", run);
  </script>
</Layout>
