---
import Layout from "../layouts/Layout.astro";
import {
    MapPin,
    Send,
    Copy,
    CheckCircle,
    Radio,
    ArrowRight,
} from "lucide-astro";

const title = "Contact - Heidar Dev Portfolio";
---

<Layout title={title}>
    <main
        class="mx-auto min-h-screen max-w-7xl px-6 pt-24"
        transition:animate="fade"
    >
        <div class="py-12">
            <div
                class="border-ink reveal mb-16 flex flex-col items-end justify-between border-b-4 pb-6 md:flex-row"
            >
                <div class="max-w-2xl">
                    <div class="mb-4 flex items-center gap-2">
                        <div
                            class="h-3 w-3 animate-pulse rounded-full bg-red-600"
                        >
                        </div>
                        <span
                            class="text-xs font-bold tracking-widest text-red-600 uppercase"
                            >Channel Open</span
                        >
                    </div>
                    <h1
                        class="text-ink mb-2 font-serif text-4xl font-bold md:text-6xl"
                    >
                        Transmission
                    </h1>
                    <p class="font-serif text-lg text-stone-600 italic">
                        Establish a connection for inquiries and collaborations.
                    </p>
                </div>
                <div
                    class="border-ink bg-ink text-paper inline-flex items-center gap-1 border px-2 py-1 text-[10px] font-bold tracking-widest uppercase"
                >
                    Frequency: 2025.0
                </div>
            </div>

            <div class="grid grid-cols-1 gap-12 lg:grid-cols-5">
                <div class="reveal reveal-delay-100 lg:col-span-3">
                    <div
                        class="bg-paper-light border-ink hard-shadow-sm relative border-2 p-8"
                    >
                        <div
                            class="bg-ink text-paper absolute top-0 left-0 px-2 py-1 text-xs font-bold uppercase"
                        >
                            Form C-19
                        </div>

                        <!-- Success State -->
                        <div
                            id="success-message"
                            class="hidden flex-col items-center justify-center py-12 text-center"
                        >
                            <CheckCircle
                                class="mb-6 h-16 w-16 text-green-600"
                            />
                            <h3
                                class="text-ink mb-2 font-serif text-2xl font-bold"
                            >
                                Transmission Received
                            </h3>
                            <p class="mb-8 max-w-md text-stone-600">
                                Your message has been logged in the system. I
                                will review the dossier and respond shortly.
                            </p>
                            <button
                                onclick="window.location.reload()"
                                class="text-ink hover:text-accent text-xs font-bold tracking-widest uppercase underline"
                            >
                                Send Another
                            </button>
                        </div>

                        <!-- Form -->
                        <form id="contact-form" class="mt-4 space-y-6">
                            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                                <div class="w-full">
                                    <label
                                        for="name"
                                        class="text-ink-muted mb-2 block text-xs font-bold tracking-widest uppercase"
                                        >Identity / Name</label
                                    >
                                    <input
                                        type="text"
                                        id="name"
                                        name="name"
                                        required
                                        class="bg-paper-wash border-line-medium text-ink focus:border-ink transition-vintage w-full border-2 p-3 font-mono focus:outline-none"
                                    />
                                </div>
                                <div class="w-full">
                                    <label
                                        for="email"
                                        class="text-ink-muted mb-2 block text-xs font-bold tracking-widest uppercase"
                                        >Return Address / Email</label
                                    >
                                    <input
                                        type="email"
                                        id="email"
                                        name="email"
                                        required
                                        class="bg-paper-wash border-line-medium text-ink focus:border-ink transition-vintage w-full border-2 p-3 font-mono focus:outline-none"
                                    />
                                </div>
                            </div>

                            <div class="space-y-2">
                                <fieldset aria-label="Subject Matter">
                                    <legend
                                        class="text-ink-muted text-xs font-bold tracking-widest uppercase"
                                    >
                                        Subject Matter
                                    </legend>
                                    <div
                                        class="grid grid-cols-1 gap-4 md:grid-cols-3"
                                    >
                                        <!-- Custom Radio Cards -->
                                        <label
                                            class="border-line-medium bg-paper-light transition-vintage focus-within:ring-accent hover:border-ink flex cursor-pointer items-center gap-2 border-2 p-3 focus-within:ring-2 focus-within:ring-offset-2"
                                        >
                                            <input
                                                type="radio"
                                                name="subject"
                                                value="Project Inquiry"
                                                checked
                                                class="peer sr-only"
                                            />
                                            <div
                                                class="border-ink-muted peer-checked:border-accent flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-2"
                                            >
                                                <div
                                                    class="bg-accent hidden h-2 w-2 rounded-full peer-checked:block"
                                                >
                                                </div>
                                            </div>
                                            <span
                                                class="text-ink-muted peer-checked:text-ink text-sm font-bold"
                                                >Project Inquiry</span
                                            >
                                        </label>

                                        <label
                                            class="border-line-medium bg-paper-light transition-vintage focus-within:ring-accent hover:border-ink flex cursor-pointer items-center gap-2 border-2 p-3 focus-within:ring-2 focus-within:ring-offset-2"
                                        >
                                            <input
                                                type="radio"
                                                name="subject"
                                                value="Consultation"
                                                class="peer sr-only"
                                            />
                                            <div
                                                class="border-ink-muted peer-checked:border-accent flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-2"
                                            >
                                                <div
                                                    class="bg-accent hidden h-2 w-2 rounded-full peer-checked:block"
                                                >
                                                </div>
                                            </div>
                                            <span
                                                class="text-ink-muted peer-checked:text-ink text-sm font-bold"
                                                >Consultation</span
                                            >
                                        </label>

                                        <label
                                            class="border-line-medium bg-paper-light transition-vintage focus-within:ring-accent hover:border-ink flex cursor-pointer items-center gap-2 border-2 p-3 focus-within:ring-2 focus-within:ring-offset-2"
                                        >
                                            <input
                                                type="radio"
                                                name="subject"
                                                value="Other"
                                                class="peer sr-only"
                                            />
                                            <div
                                                class="border-ink-muted peer-checked:border-accent flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-2"
                                            >
                                                <div
                                                    class="bg-accent hidden h-2 w-2 rounded-full peer-checked:block"
                                                >
                                                </div>
                                            </div>
                                            <span
                                                class="text-ink-muted peer-checked:text-ink text-sm font-bold"
                                                >Other</span
                                            >
                                        </label>
                                    </div>
                                </fieldset>

                                <div class="w-full">
                                    <label
                                        for="message"
                                        class="text-ink-muted mb-2 block text-xs font-bold tracking-widest uppercase"
                                        >Message Content</label
                                    >
                                    <textarea
                                        id="message"
                                        name="message"
                                        rows="6"
                                        required
                                        class="bg-paper-wash border-line-medium text-ink focus:border-ink transition-vintage w-full resize-none border-2 p-3 font-mono focus:outline-none"
                                    ></textarea>
                                </div>

                                <button
                                    type="submit"
                                    class="bg-ink text-paper border-ink hover:bg-accent hover:border-accent hard-shadow-sm inline-flex w-full items-center justify-center gap-2 border-2 px-6 py-3 font-bold tracking-widest uppercase transition-colors duration-200"
                                >
                                    Initiate Transmission
                                    <Send class="h-4 w-4" />
                                </button>
                            </div>
                        </form>
                    </div>

                    <div
                        class="reveal reveal-delay-200 space-y-8 lg:col-span-2"
                    >
                        <div class="bg-paper-dim border-ink border-l-4 p-6">
                            <h3
                                class="text-ink mb-4 flex items-center gap-2 font-serif text-xl font-bold"
                            >
                                <Radio class="h-5 w-5" />
                                Direct Line
                            </h3>
                            <div class="space-y-6">
                                <div class="group">
                                    <div
                                        class="mb-1 text-xs font-bold text-stone-500 uppercase"
                                    >
                                        Email Protocol
                                    </div>
                                    <div
                                        class="bg-paper-light border-line-medium group-hover:border-ink transition-vintage flex items-center justify-between gap-2 border p-3"
                                    >
                                        <span
                                            class="text-ink truncate overflow-hidden font-mono text-sm"
                                            >xeydarcabdi3@gmail.com</span
                                        >
                                        <button
                                            onclick="copyToClipboard('xeydarcabdi3@gmail.com', 'copy-email-icon')"
                                            class="hover:text-ink text-stone-400 focus:outline-none"
                                        >
                                            <div id="copy-email-icon">
                                                <Copy class="h-4 w-4" />
                                            </div>
                                        </button>
                                    </div>
                                </div>
                                <div class="group">
                                    <div
                                        class="mb-1 text-xs font-bold text-stone-500 uppercase"
                                    >
                                        Voice / Mobile
                                    </div>
                                    <div
                                        class="bg-paper-light border-line-medium group-hover:border-ink transition-vintage flex items-center justify-between gap-2 border p-3"
                                    >
                                        <span class="text-ink font-mono text-sm"
                                            >+252 615054820</span
                                        >
                                        <button
                                            onclick="copyToClipboard('+252 615054820', 'copy-phone-icon')"
                                            class="hover:text-ink text-stone-400 focus:outline-none"
                                        >
                                            <div id="copy-phone-icon">
                                                <Copy class="h-4 w-4" />
                                            </div>
                                        </button>
                                    </div>
                                </div>
                                <div class="group">
                                    <div
                                        class="mb-1 text-xs font-bold text-stone-500 uppercase"
                                    >
                                        Coordinates
                                    </div>
                                    <div
                                        class="bg-paper-light border-line-medium flex items-center gap-2 border p-3"
                                    >
                                        <MapPin class="text-accent h-4 w-4" />
                                        <span class="text-ink font-mono text-sm"
                                            >Mogadishu, SO</span
                                        >
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div
                            class="bg-ink text-paper relative overflow-hidden p-6"
                        >
                            <div class="absolute top-0 right-0 p-8 opacity-10">
                                <ArrowRight class="h-24 w-24 -rotate-45" />
                            </div>
                            <h3
                                class="relative z-10 mb-4 font-serif text-xl font-bold"
                            >
                                Availability Status
                            </h3>
                            <div
                                class="relative z-10 mb-4 flex items-center gap-3"
                            >
                                <div
                                    class="h-3 w-3 animate-pulse rounded-full bg-green-500"
                                >
                                </div>
                                <span
                                    class="font-mono text-sm font-bold text-green-400"
                                    >OPEN FOR COMMISSIONS</span
                                >
                            </div>
                            <p
                                class="relative z-10 font-serif text-sm leading-relaxed text-stone-400 italic"
                            >
                                Currently accepting new projects for Q1 2025.
                                Specialized in Full Stack Architecture and
                                Machine Learning Integration.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script is:inline>
            // ---------------------------------------------------------
            // CONTACT FORM LOGIC
            // ---------------------------------------------------------
            function initContactForm() {
                const contactForm = document.getElementById("contact-form");
                if (contactForm) {
                    contactForm.addEventListener("submit", (e) => {
                        e.preventDefault();

                        const submitBtn = contactForm.querySelector(
                            'button[type="submit"]',
                        );
                        const originalContent = submitBtn.innerHTML;
                        // We use a simple SVG string for the spinner to avoid hydration issues in inline script
                        const spinnerIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-2 w-4 h-4 animate-spin"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>`;

                        submitBtn.innerHTML = `${spinnerIcon} Sending...`;
                        submitBtn.disabled = true;

                        // Simulate API call
                        setTimeout(() => {
                            contactForm.classList.add("hidden");
                            const successMsg =
                                document.getElementById("success-message");
                            successMsg.classList.remove("hidden");
                            successMsg.classList.add("flex");

                            // Reset for next time (though form is hidden)
                            submitBtn.innerHTML = originalContent;
                            submitBtn.disabled = false;
                            contactForm.reset();
                        }, 1500);
                    });
                }
            }

            // ---------------------------------------------------------
            // CLIPBOARD LOGIC
            // ---------------------------------------------------------
            // Define function globally for onclick handlers
            window.copyToClipboard = function (text, iconId) {
                if (text) {
                    navigator.clipboard.writeText(text).then(() => {
                        const iconContainer = document.getElementById(iconId);
                        if (iconContainer) {
                            const originalHTML = iconContainer.innerHTML;
                            const checkIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check w-4 h-4 text-green-400"><path d="M20 6 9 17l-5-5"/></svg>`;
                            iconContainer.innerHTML = checkIcon;

                            setTimeout(() => {
                                iconContainer.innerHTML = originalHTML;
                            }, 2000);
                        }
                    });
                }
            };

            function run() {
                initContactForm();
            }

            document.addEventListener("astro:page-load", run);
            if (document.readyState !== "loading") run();
            else document.addEventListener("DOMContentLoaded", run);
        </script>
    </main>
</Layout>
