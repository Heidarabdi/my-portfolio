---
import StudioLayout from "../layouts/StudioLayout.astro";
import {
  ArrowUpRight,
  Check,
  CheckCircle,
  Copy,
  Github,
  Mail,
  MapPin,
  Phone,
  Send,
} from "lucide-astro";
---

<StudioLayout
  title="Contact — Heidar Abdi"
  description="Have a project in mind? Get in touch with Heidar for web development, machine learning integration, and IT projects."
  current="contact"
>
  <main id="main-content">
    <header class="studio-page-heading home-inset">
      <span class="studio-eyebrow">CONTACT</span>
      <div class="studio-heading-row">
        <h1>Have an idea?<br /><em>Let’s talk.</em></h1>
        <p>
          A new website, a useful model, or a system that needs connecting. Tell
          me what you have in mind.
        </p>
      </div>
    </header>
    <portfolio-contact class="studio-contact home-inset">
      <div class="studio-contact-grid">
        <section
          class="studio-contact-form-panel"
          aria-labelledby="contact-form-title"
        >
          <div
            id="success-message"
            tabindex="-1"
            role="status"
            class="studio-contact-success hidden"
          >
            <CheckCircle size={56} aria-hidden="true" />
            <h2>Message sent.</h2>
            <p>
              Your email has been sent. I’ll get back to you as soon as I can.
            </p>
            <button id="send-another" type="button" class="home-button"
              >Send another <ArrowUpRight
                size={18}
                aria-hidden="true"
              /></button
            >
          </div>
          <form id="contact-form" action="/api/contact" method="post">
            <div class="studio-form-heading">
              <h2 id="contact-form-title">Tell me about it.</h2>
              <p>A few details are all we need to start.</p>
            </div>
            <div hidden aria-hidden="true">
              <label for="website">Website</label>
              <input
                type="text"
                id="website"
                name="website"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <div class="studio-contact-fields">
              <div class="studio-form-field">
                <label for="name">Your name</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  autocomplete="name"
                  maxlength="100"
                  required
                  placeholder="Your full name"
                />
              </div>
              <div class="studio-form-field">
                <label for="email">Email address</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  autocomplete="email"
                  maxlength="254"
                  required
                  placeholder="you@example.com"
                />
              </div>
            </div>
            <fieldset class="studio-contact-subject">
              <legend>What would you like to discuss?</legend>
              <div>
                {
                  ["Project Inquiry", "Consultation", "Other"].map(
                    (subject, index) => (
                      <label>
                        <input
                          type="radio"
                          name="subject"
                          value={subject}
                          checked={index === 0}
                        />
                        <span>{subject}</span>
                      </label>
                    ),
                  )
                }
              </div>
            </fieldset>
            <div class="studio-form-field">
              <label for="message">Your message</label>
              <textarea
                id="message"
                name="message"
                rows="6"
                minlength="20"
                maxlength="5000"
                required
                placeholder="What are you working on, and how can I help?"
                aria-describedby="message-hint"></textarea>
              <p id="message-hint" class="studio-field-hint">
                At least 20 characters. A little context goes a long way.
              </p>
            </div>
            <div id="contact-verification" class="studio-contact-verification">
            </div>
            <p
              id="contact-status"
              role="status"
              aria-live="polite"
              class="studio-contact-status"
            >
              Loading the security check…
            </p>
            <noscript
              ><p>
                Please enable JavaScript to use this form, or <a
                  href="mailto:xeydarcabdi3@gmail.com">email me directly</a
                >.
              </p></noscript
            >
            <button
              type="submit"
              disabled
              class="home-button studio-contact-submit"
              ><span>Send message</span><Send
                size={18}
                aria-hidden="true"
              /></button
            >
            <p class="studio-contact-privacy">
              Your message is emailed directly to me. This website does not
              store submissions.
            </p>
          </form>
        </section>
        <aside class="studio-contact-aside" aria-label="Other ways to connect">
          <section
            class="studio-direct-contact"
            aria-labelledby="direct-contact-title"
          >
            <span class="studio-contact-icon"
              ><Mail size={24} aria-hidden="true" /></span
            >
            <h2 id="direct-contact-title">Prefer a direct hello?</h2>
            <p>You can reach me here, too.</p>
            <dl>
              <div>
                <dt>Email</dt>
                <dd>
                  <a href="mailto:xeydarcabdi3@gmail.com"
                    >xeydarcabdi3@gmail.com</a
                  ><button
                    data-copy="xeydarcabdi3@gmail.com"
                    type="button"
                    aria-label="Copy email address"
                    ><Copy size={18} aria-hidden="true" /></button
                  >
                </dd>
              </div>
              <div>
                <dt>Phone</dt>
                <dd>
                  <a href="tel:+252615054820"
                    ><Phone size={16} aria-hidden="true" />+252 615054820</a
                  ><button
                    data-copy="+252 615054820"
                    type="button"
                    aria-label="Copy phone number"
                    ><Copy size={18} aria-hidden="true" /></button
                  >
                </dd>
              </div>
              <div>
                <dt>Based in</dt>
                <dd>
                  <span
                    ><MapPin size={17} aria-hidden="true" />Mogadishu, Somalia</span
                  >
                </dd>
              </div>
            </dl>
            <a
              class="studio-contact-github"
              href="https://github.com/Heidarabdi"
              target="_blank"
              rel="noopener noreferrer"
              ><Github size={19} aria-hidden="true" /> Find me on GitHub <ArrowUpRight
                size={18}
                aria-hidden="true"
              /></a
            >
          </section>
          <section
            class="studio-contact-availability"
            aria-labelledby="availability-title"
          >
            <span class="studio-availability-label"
              ><span aria-hidden="true"></span>Available for new projects</span
            >
            <h2 id="availability-title">Good ideas can<br />start anywhere.</h2>
            <p>Based in Mogadishu. Open to collaborating worldwide.</p>
            <ul>
              <li><Check size={17} aria-hidden="true" />Web development</li>
              <li>
                <Check size={17} aria-hidden="true" />Machine learning
                integration
              </li>
              <li><Check size={17} aria-hidden="true" />IT & systems</li>
            </ul>
          </section>
        </aside>
      </div>
      <script>
        import "../scripts/contact";
      </script>
    </portfolio-contact>
  </main>
</StudioLayout>
