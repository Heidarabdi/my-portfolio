---
import StudioLayout from "../../layouts/StudioLayout.astro";
import StudioCTA from "../../components/studio/StudioCTA.astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { ArrowLeft, ArrowUpRight, Clock } from "lucide-astro";
import { journalImages, formatPostDate } from "../../data/journal";
import developer from "../../assets/home/developer.png";
export async function getStaticPaths() {
  return (await getCollection("blog")).map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const image = journalImages[post.id];
---

<StudioLayout
  current="blog"
  title={`${post.data.title} — Heidar’s Journal`}
  description={post.data.excerpt}
>
  <main id="main-content" class="studio-reading-page">
    <article>
      <header class="studio-reading-header home-inset">
        <a class="studio-back-link" href="/blog"
          ><ArrowLeft size={17} aria-hidden="true" /> Back to journal</a
        ><span class="studio-reading-category">{post.data.category}</span><h1>
          {post.data.title}
        </h1><p class="studio-reading-excerpt">{post.data.excerpt}</p><div
          class="studio-reading-meta"
        >
          <a href="/about" class="studio-reading-author"
            ><Image
              src={developer}
              alt=""
              width={56}
              height={56}
              fit="cover"
              position="top"
            /><span>Heidar Abdi</span></a
          ><time datetime={post.data.date.toISOString()}
            >{formatPostDate(post.data.date)}</time
          ><span
            ><Clock size={16} aria-hidden="true" />{post.data.readTime}</span>
        </div>
      </header>
      <div class="studio-reading-image home-inset">
        {
          image ? (
            <Image
              src={image}
              alt=""
              width={1400}
              widths={[600, 1000, 1400]}
              sizes="(max-width: 1440px) 90vw, 1280px"
              loading="eager"
            />
          ) : (
            <img src={post.data.imageUrl} alt="" width="1200" height="700" />
          )
        }
      </div>
      <div class="studio-reading-body">
        <div class="studio-article-content"><Content /></div><aside
          class="studio-author-card"
        >
          <div>
            <p>Written by</p><h2>Heidar Abdi Ahmed</h2><p>
              Full stack developer and machine learning engineer. Connecting
              practical intelligence with thoughtful web experiences, from
              Mogadishu.
            </p>
          </div><a class="studio-text-link" href="/about"
            >More about me <ArrowUpRight size={18} aria-hidden="true" /></a>
        </aside><a href="/blog" class="studio-back-link"
          ><ArrowLeft size={17} aria-hidden="true" /> Explore more articles</a>
      </div>
    </article>
    <StudioCTA title="Let’s put ideas into practice." />
  </main>
</StudioLayout>
