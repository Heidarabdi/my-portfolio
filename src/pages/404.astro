---
import StudioLayout from "../layouts/StudioLayout.astro";
import { ArrowUpRight } from "lucide-astro";
---

<StudioLayout
  title="Page not found — Heidar Abdi"
  description="This page could not be found. Explore Heidar's portfolio or return to the homepage."
>
  <main id="main-content" class="studio-not-found home-inset">
    <p class="studio-muted">404 / Page not found</p>
    <div class="studio-heading-row">
      <h1>This page<br /><em>isn’t here.</em></h1>
      <p>
        The link may have changed, or the page may no longer exist. Let’s get
        you back to the portfolio.
      </p>
    </div>
    <div class="studio-inline-actions">
      <a class="home-button" href="/"
        >Back to home <ArrowUpRight size={18} aria-hidden="true" /></a
      >
      <a class="studio-text-link" href="/projects"
        >Explore projects <ArrowUpRight size={18} aria-hidden="true" /></a
      >
    </div>
  </main>
</StudioLayout>
