---
import StudioLayout from "../layouts/StudioLayout.astro";
import StudioCTA from "../components/studio/StudioCTA.astro";
import { Image } from "astro:assets";
import {
  ArrowUpRight,
  MapPin,
  CodeXml,
  Cpu,
  Server,
  GraduationCap,
  Award,
  Github,
} from "lucide-astro";
import developer from "../assets/home/developer.png";
import { experience } from "../data/home";
const skills = [
  {
    icon: CodeXml,
    title: "Web development",
    text: "Interfaces that feel clear and work across devices.",
    tools: [
      "React",
      "Node.js",
      "TypeScript",
      "Responsive design",
      "API integration",
    ],
  },
  {
    icon: Cpu,
    title: "Machine learning",
    text: "Practical models connected to real applications.",
    tools: [
      "Python",
      "Model development",
      "NLP",
      "Scikit-learn",
      "Data visualization",
    ],
  },
  {
    icon: Server,
    title: "IT & systems",
    text: "The dependable foundations behind everyday work.",
    tools: [
      "Technical support",
      "System maintenance",
      "Hardware troubleshooting",
      "Automation",
    ],
  },
];
const education = [
  {
    title: "Bachelor of Computer Application",
    organization: "Jamhuriya University of Science & Technology",
    years: "2020–2024",
  },
  {
    title: "High School Diploma",
    organization: "Hoyga Xamar School",
    years: "2013–2018",
  },
  {
    title: "Primary School",
    organization: "Hoyga Xamar School",
    years: "2009–2013",
  },
];
const certificates = [
  {
    title: "Deep Learning Specialization",
    organization: "DeepLearning.AI",
    year: "2024",
  },
  {
    title: "Full Stack Web Development Bootcamp",
    organization: "Udemy",
    year: "2023",
  },
  {
    title: "Google IT Support Professional Certificate",
    organization: "Coursera",
    year: "2023",
  },
  {
    title: "Advanced Python for Data Science",
    organization: "DataCamp",
    year: "2022",
  },
];
---

<StudioLayout
  current="about"
  title="About — Heidar Abdi"
  description="Meet Heidar Abdi Ahmed, a full stack developer and machine learning engineer based in Mogadishu, Somalia."
>
  <main id="main-content" class="studio-about-page">
    <section
      class="studio-about-hero home-inset"
      aria-labelledby="about-heading"
    >
      <div class="studio-about-intro">
        <p class="studio-location">
          <MapPin size={17} aria-hidden="true" /> Mogadishu, Somalia · Working worldwide
        </p><h1 id="about-heading">
          Hi, I’m Heidar.<br /><em>I connect the dots.</em>
        </h1><p class="studio-about-role">
          Full Stack Developer &amp;<br />Machine Learning Engineer
        </p><p>
          I bring together thoughtful interfaces, practical machine learning,
          and dependable systems to build things people can use.
        </p><div class="studio-inline-actions">
          <a class="home-button" href="/contact"
            >Let’s work together <ArrowUpRight
              size={20}
              aria-hidden="true"
            /></a
          ><a
            class="studio-text-link"
            href="https://github.com/Heidarabdi"
            target="_blank"
            rel="noopener noreferrer"
            ><Github size={19} aria-hidden="true" /> GitHub</a>
        </div>
      </div><figure class="studio-about-art">
        <div class="studio-portrait-disc" aria-hidden="true"></div><Image
          src={developer}
          alt="Illustration of a developer holding a laptop"
          width={600}
          widths={[400, 600, 900]}
          sizes="(max-width: 700px) 90vw, 45vw"
          loading="eager"
        /><figcaption>
          <span class="studio-availability-dot" aria-hidden="true"
          ></span>Available for new projects
        </figcaption>
      </figure>
    </section>
    <section class="studio-story home-inset" aria-labelledby="story-title">
      <h2 id="story-title">Curiosity is where<br />the work starts.</h2><div>
        <p>
          I enjoy the space where different disciplines meet: turning a machine
          learning model into an accessible web experience, or solving the
          system problem that keeps a team from moving forward.
        </p><p>
          My work has taken me across research at Setsom Institute, digital
          communication for the Somali National Women Organization, and campus
          IT support at Jamhuriya University. That range helps me see both the
          interface and the infrastructure behind it.
        </p><a class="studio-text-link" href="/projects"
          >Explore my projects <ArrowUpRight size={18} aria-hidden="true" /></a>
      </div>
    </section>
    <section
      class="studio-skills home-dark home-inset"
      aria-labelledby="skills-title"
    >
      <div class="home-section-header">
        <h2 id="skills-title">What I bring<br /><em>to the table.</em></h2><p>
          Three connected disciplines.<br />One practical approach.
        </p>
      </div><div class="studio-skills-grid">
        {
          skills.map((skill) => (
            <div>
              <>
                <skill.icon size={30} aria-hidden="true" />
                <h3>{skill.title}</h3>
                <p>{skill.text}</p>
                <ul>
                  {skill.tools.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
              </>
            </div>
          ))
        }
      </div>
    </section>
    <section
      class="studio-about-experience home-inset"
      aria-labelledby="experience-title"
    >
      <div class="studio-subheading">
        <h2 id="experience-title">
          Experience that<br /><em>shapes my work.</em>
        </h2><p>Research, community, and campus projects.</p>
      </div><ol class="studio-about-timeline">
        {
          experience.map((item) => (
            <li>
              <>
                <span class="studio-timeline-year">{item.year}</span>
                <div>
                  <>
                    <h3>{item.role}</h3>
                    <p class="studio-timeline-org">{item.organization}</p>
                    <p>{item.description}</p>
                  </>
                </div>
              </>
            </li>
          ))
        }
      </ol>
    </section>
    <section
      class="studio-background home-inset"
      aria-labelledby="background-title"
    >
      <div class="studio-education">
        <h2 id="background-title">
          <GraduationCap size={26} aria-hidden="true" /> Education
        </h2>{
          education.map((item) => (
            <div class="studio-background-row">
              <>
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.organization}</p>
                  </>
                </div>
                <span>{item.years}</span>
              </>
            </div>
          ))
        }
      </div><div class="studio-certificates">
        <h2><Award size={26} aria-hidden="true" /> Continued learning</h2>{
          certificates.map((item) => (
            <div class="studio-background-row">
              <>
                <div>
                  <>
                    <h3>{item.title}</h3>
                    <p>{item.organization}</p>
                  </>
                </div>
                <span>{item.year}</span>
              </>
            </div>
          ))
        }
      </div>
    </section>
    <section class="studio-about-facts home-inset">
      <div>
        <h2>A little more about me.</h2><p>
          I work in English and Somali, and I’m open to conversations about
          freelance projects and full-time opportunities.
        </p>
      </div><dl>
        <div><dt>Somali</dt><dd>Native</dd></div><div>
          <dt>English</dt><dd>Fluent</dd>
        </div>
      </dl><a
        class="home-button home-button-outline"
        href="mailto:xeydarcabdi3@gmail.com?subject=CV%20request"
        >Request my CV <ArrowUpRight size={18} aria-hidden="true" /></a>
    </section>
    <StudioCTA title="What could we build together?" />
  </main>
</StudioLayout>
