{
  "name": "tensor-hubble",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && npm run check:worker",
    "test": "node --test",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:worker": "cf workers types && tsc -p worker/tsconfig.json",
    "build:cloudflare": "npm run build && vite build",
    "dev:cloudflare": "npm run build && cf-vite dev",
    "deploy": "cf pages deployments create heidar-dev --branch master"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-astro": "^0.556.0",
    "nodemailer": "^10.5.0",
    "pdf-parse": "^2.4.5",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.17",
    "@cloudflare/workers-types": "^5.20261114.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/nodemailer": "^8.0.2",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "astro-eslint-parser": "^3.1.0",
    "autoprefixer": "^10.5.4",
    "cf": "1.0.0-beta.32",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  }
}
