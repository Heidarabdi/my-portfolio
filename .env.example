# Environment Variables Example
# Copy this file to .env and fill in your actual values

# Site Configuration
PUBLIC_SITE_URL=https://heidar-dev.pages.dev
PUBLIC_SITE_NAME="Heidar Dev Portfolio"

# Contact form configuration lives in cloudflare.config.ts.
# TURNSTILE_SECRET is a Worker runtime secret. See docs/contact-setup.md.
# Do not put email credentials or Turnstile secrets in PUBLIC_ variables.

# Analytics (if you add analytics)
# PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
PUBLIC_CF_ANALYTICS_TOKEN=your-cloudflare-analytics-token

# Social Media
PUBLIC_TWITTER_HANDLE=@heidarabdi
PUBLIC_GITHUB_USERNAME=Heidarabdi

# Feature Flags
# PUBLIC_ENABLE_COMMENTS=false
# PUBLIC_ENABLE_SEARCH=false
