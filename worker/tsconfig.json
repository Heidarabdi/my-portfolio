{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "./**/*.ts",
    "../functions/**/*.ts",
    "../cloudflare.config.ts",
    "../.cloudflare/types/**/*.d.ts"
  ]
}
